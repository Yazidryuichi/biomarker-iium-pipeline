# ============================================================
# CRITICAL: Patient data must NEVER be committed
# ============================================================
# EDF files carry children's full names in their filenames, and the Digit Span
# workbooks carry a Kode -> Nama mapping that de-anonymises the whole dataset.
data/*.edf
data/*.xlsx
data/*.csv
data/**/*.edf
data/Behavioral/
data/EDF/
data/EDF19/

# Raw data / consent / ethics directories (carried over from the pre-restructure
# main branch — kept because the risk they guard against has not changed).
EF_Biomarker/
EDF_Files/
AUFEI-O/
Digital_Consent/
Ethic_Approval_Docs/
Archives/

# ---- instruments/ : publish the task, never the responses ----
# The instrument folders hold their own participant data. Flanker CSV/log/psydat
# filenames contain children's given names, and so does the participant column
# inside them; the cleaned exports key rows by name rather than by code; the
# Digit Span workbooks carry the Kode -> Nama mapping. None of it may ship.
instruments/flanker/data/
instruments/flanker/experiment/data/
instruments/flanker/cleaned/
instruments/flanker/cleaned_data/
instruments/flanker/psychopy_env/
instruments/digit_span/output/
# Saved mid-session from the browser: the rendered results table still holds
# seven children's names. A blank copy of the tool is already tracked as
# digit_span_admin.html — this one is a session artefact, not an instrument.
instruments/digit_span/saved_page/

# Stage outputs (regenerable). Each stage writes timestamped runs to
# <stage>/output/<YYYY-MM-DD_HHMMSS>/. We keep the output/ folder itself
# tracked (placeholder) but ignore everything inside.
preprocessing/output/*
validation/output/*
feature_building/output/*
feature_engineering/output/*
analysis/output/*
data_quality_check/output/*
research_report/output/*
!preprocessing/output/.gitkeep
!validation/output/.gitkeep
!feature_building/output/.gitkeep
!feature_engineering/output/.gitkeep
!analysis/output/.gitkeep
!data_quality_check/output/.gitkeep
!research_report/output/.gitkeep

# Heavy artifacts (defensive — same as the per-stage rules above)
*.fif
*.npz
logs/
results/
figures/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
env/
catboost_info/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Manuscripts, ethics paperwork, journal templates.
# These carry investigator names, protocol detail, and unpublished findings —
# they do not belong in the code repository regardless of its visibility.
*.pdf
*.docx
*.doc

# OS / IDE / env
.DS_Store
Thumbs.db
*.swp
*.swo
*.sublime-*
.vscode/
.idea/
.claude/
.env
.env.keys
