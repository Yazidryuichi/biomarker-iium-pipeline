# ============================================================
# CRITICAL: Patient data must NEVER be committed
# ============================================================
data/*.edf
data/*.xlsx
data/*.csv
data/**/*.edf
data/Behavioral/
data/EDF/

# Stage outputs (regenerable). Each stage writes timestamped runs to
# <stage>/output/<YYYY-MM-DD_HHMMSS>/. We keep the output/ folder itself
# tracked (placeholder) but ignore everything inside.
preprocessing/output/*
validation/output/*
feature_building/output/*
feature_engineering/output/*
analysis/output/*
data_quality_check/output/*
research_report/output/*
!preprocessing/output/.gitkeep
!validation/output/.gitkeep
!feature_building/output/.gitkeep
!feature_engineering/output/.gitkeep
!analysis/output/.gitkeep
!data_quality_check/output/.gitkeep
!research_report/output/.gitkeep

# Heavy artifacts (defensive — same as the per-stage rules above)
*.fif
*.npz

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Manuscripts, ethics paperwork, journal templates.
# These carry investigator names, protocol detail, and unpublished findings —
# they do not belong in the code repository regardless of its visibility.
*.pdf
*.docx
*.doc

# OS / IDE / env
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
.claude/
.env
.env.keys
